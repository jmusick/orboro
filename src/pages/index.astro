---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostListItem from "../components/PostListItem.astro";
import Button from "../components/Button.astro";
import SidebarLayout from "../components/SidebarLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import FeaturedTools from "../components/FeaturedTools.astro";
import { getPublishedContentByType, excerptFromMarkdown, listCategoriesWithPostCounts, listHomepageFeatures } from "../lib/content";

const [rawPosts, featuredPages, categories] = await Promise.all([
  getPublishedContentByType(Astro.locals, "post", 5),
  listHomepageFeatures(Astro.locals),
  listCategoriesWithPostCounts(Astro.locals),
]);
const posts = rawPosts.map((post) => {
	const date = post.publishedAt ?? post.createdAt;
	return {
		...post,
		excerpt: excerptFromMarkdown(post.markdown, 300),
		dateIso: new Date(date).toISOString(),
		dateLabel: new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }),
	};
});
// The newest post leads the page; the rest form the feed below it.
const lead = posts[0];
const leadExcerpt = lead ? excerptFromMarkdown(lead.markdown, 200) : "";
const feedPosts = posts.slice(1);

const recentPosts = posts.slice(0, 5);
---

<BaseLayout title="Orboro.net | Gaming guides, analysis, and developer resources" description="World of Warcraft and Path of Exile guides, game analysis, and developer resources from JD." structuredData={{
	"@context": "https://schema.org",
	"@graph": [
		{ "@type": "WebSite", "@id": "https://orboro.net/#website", url: "https://orboro.net/", name: "Orboro.net", author: { "@id": "https://orboro.net/#jd" } },
		{ "@type": "Person", "@id": "https://orboro.net/#jd", name: "JD", url: "https://orboro.net/pages/about" },
	],
}}>
	{lead && (
		<article slot="headerFeature" class="lead" aria-labelledby="lead-title">
			<div class="lead__body">
				<p class="lead__date"><time datetime={lead.dateIso}>{lead.dateLabel}</time></p>
				<h1 id="lead-title" class="lead__title"><a href={`/blog/${lead.slug}`}>{lead.title}</a></h1>
				{leadExcerpt && <p class="lead__excerpt">{leadExcerpt}</p>}
				<Button class="lead__cta" href={`/blog/${lead.slug}`}>Read the post</Button>
			</div>
			{lead.featuredImageUrl && (
				<a class="lead__art" href={`/blog/${lead.slug}`} tabindex="-1" aria-hidden="true">
					<img src={lead.featuredImageUrl} alt="" fetchpriority="high" />
				</a>
			)}
		</article>
	)}
	<SidebarLayout>
		<div class="home-content">
			<FeaturedTools pages={featuredPages} />
			<section class="feed-section" aria-labelledby="feed-title">
				<div class="feed-header">
					<h2 id="feed-title">Recent articles</h2>
					<Button href="/blog" variant="tertiary" size="sm">All posts</Button>
				</div>
				{posts.length === 0 ? (
					<p class="empty-note">No posts published yet.</p>
				) : feedPosts.length === 0 ? (
					<p class="empty-note">More posts coming soon.</p>
				) : (
					<div class="feed-list" id="home-feed">
						{feedPosts.map((post) => (
							<PostListItem post={post} />
						))}
					</div>
				)}
			</section>
		</div>

		<Sidebar slot="sidebar" categories={categories} recentPosts={recentPosts} />
	</SidebarLayout>
</BaseLayout>

<style>
	/* A compact lead leaves room for tools and the article feed. */
	.lead {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		margin-bottom: 1.2rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--r-lg,16px);
		overflow: hidden;
	}

	.lead__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		padding: clamp(1.25rem, 2vw, 1.75rem);
	}

	.lead__date {
		margin: 0 0 0.65rem;
		color: var(--muted);
		font-size: 0.95rem;
		font-weight: 500;
	}

	.lead__title {
		margin: 0;
		font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2.1rem);
		font-weight: 850;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.lead__title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.lead__title a:hover {
		color: var(--accent);
	}

	.lead__excerpt {
		max-width: 34rem;
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-family: var(--font-read);
		font-size: 1rem;
		line-height: 1.6;
	}

	.lead__body :global(.lead__cta) { margin-top: 1rem; }
	.lead:not(:has(.lead__art)) { grid-template-columns: 1fr; }

	.lead__art {
		display: block;
		position: relative;
		min-height: 12rem;
		border-left: 1px solid var(--line);
	}

	.lead__art img {
		display: block;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 600px) {
		.lead { grid-template-columns: 1fr; }
		.lead__art { order: -1; height: 8rem; min-height: 0; border-left: 0; border-bottom: 1px solid var(--line); }
	}

	/* ── Feed + sidebar ─────────────────────── */

	.feed-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.feed-header h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	.empty-note {
		color: var(--muted);
	}

	.feed-list {
		display: flex;
		flex-direction: column;
	}

</style>
