---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { getPublishedContentByType, excerptFromMarkdown } from "../lib/content";

const rawPosts = await getPublishedContentByType(Astro.locals, "post", 8);
const posts = rawPosts.map((post) => {
	const date = post.publishedAt ?? post.createdAt;
	const excerpt = excerptFromMarkdown(post.markdown, 300);
	const truncated = excerpt.endsWith("…");
	return {
		...post,
		excerpt,
		truncated,
		dateLabel: new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }),
	};
});

const profiles = [
	{
		platform: "Patreon",
		handle: "Support Orboro.net",
		icon: "patreon",
		url: "https://www.patreon.com/cw/Orboro",
	},
	{
		platform: "Discord",
		handle: "xing_yuen",
		icon: "discord",
	},
	{
		platform: "Battle.net",
		handle: "Xing#1673",
		icon: "battlenet",
	},
	{
		platform: "Steam",
		handle: "XingYuen",
		icon: "steam",
		url: "https://steamcommunity.com/id/XingYuen/",
	},
	{
		platform: "Reddit",
		handle: "u/XingYuen",
		icon: "reddit",
		url: "https://www.reddit.com/user/XingYuen/",
	},
	{
		platform: "YouTube",
		handle: "@XingYuen",
		icon: "youtube",
		url: "https://www.youtube.com/@XingYuen",
	},
	{
		platform: "Twitch",
		handle: "xingyuen",
		icon: "twitch",
		url: "https://www.twitch.tv/xingyuen",
	},
];
---


<BaseLayout title="Orboro.net" description="Latest posts and gamer profiles from Orboro.net.">
	<div class="home-layout">
		<section class="feed-section">
			<div class="feed-header">
				<h2>Latest Posts</h2>
				<Button href="/blog" variant="tertiary" icon="chevron-right" iconPosition="right">View all posts</Button>
			</div>
			{posts.length === 0 ? (
				<p class="empty-note">No posts published yet.</p>
			) : (
				<div class="feed-list" id="home-feed">
					{posts.map((post) => (
						<article class="feed-item">
							{post.featuredImageUrl && (
								<a class="feed-item__thumb" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
									<img src={post.featuredImageUrl} alt="" loading="lazy" />
								</a>
							)}
							<div class="feed-item__body">
								<p class="feed-item__date">{post.dateLabel}</p>
								<h3 class="feed-item__title"><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
								{post.excerpt && <p class="feed-item__excerpt">{post.excerpt}</p>}
								{post.truncated && (
									<a class="feed-item__more" href={`/blog/${post.slug}`}>Read full post</a>
								)}
							</div>
						</article>
					))}
				</div>
			)}
		</section>

		<div class="side-column">
			<aside class="profiles-column">
				<h2>Find Me Elsewhere</h2>
				<div class="profiles-list">
					{profiles.map((profile) => {
						const Tag = profile.url ? "a" : "div";
						const linkProps = profile.url ? { href: profile.url, target: "_blank", rel: "noopener noreferrer" } : {};
						return (
							<Tag class="profile-row" {...linkProps}>
								<Icon name={profile.icon} size={20} filled={true} />
								<span class="profile-row__text">
									<strong>{profile.platform}</strong>
									<span>{profile.handle}</span>
								</span>
								{profile.url && <Icon name="external-link" size={14} class="profile-row__external" />}
							</Tag>
						);
					})}
				</div>
			</aside>

		</div>
	</div>
</BaseLayout>

<style>
	.home-layout {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.side-column {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.feed-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.feed-header h2,
	.profiles-column h2 {
		margin: 0;
		font-size: 1.3rem;
	}

	.profiles-column h2 {
		margin-bottom: 1.25rem;
	}

	.empty-note {
		color: var(--muted);
	}

	.feed-list {
		display: flex;
		flex-direction: column;
	}

	.feed-item {
		display: flex;
		gap: 1rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
	}

	.feed-item:first-child {
		padding-top: 0;
	}

	.feed-item:last-child {
		border-bottom: none;
	}

	.feed-item__thumb {
		flex-shrink: 0;
		display: block;
		width: 120px;
		height: 90px;
		border-radius: var(--r-md,10px);
		overflow: hidden;
	}

	.feed-item__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.feed-item__body {
		min-width: 0;
		flex: 1;
	}

	@media (max-width: 480px) {
		.feed-item__thumb {
			width: 84px;
			height: 84px;
		}
	}

	.feed-item__date {
		margin: 0 0 0.3rem;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.feed-item__title {
		margin: 0 0 0.4rem;
		font-size: 1.1rem;
		font-weight: 600;
	}

	.feed-item__title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.feed-item__title a:hover {
		color: var(--accent);
	}

	.feed-item__excerpt {
		margin: 0;
		font-size: 0.92rem;
		color: var(--muted);
		line-height: 1.5;
	}

	.feed-item__more {
		display: inline-block;
		margin-top: 0.75rem;
		padding: 0.4rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: var(--r-md,10px);
		background: var(--surface);
		color: var(--accent);
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.feed-item__more:hover {
		border-color: var(--accent);
		background: rgb(0 229 255 / 8%);
	}

	.profiles-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.profile-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 0.75rem;
		background: linear-gradient(160deg, rgb(12 19 36 / 60%) 0%, rgb(17 26 48 / 60%) 100%);
		border: 1px solid var(--line);
		border-radius: var(--r-md,10px);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	a.profile-row:hover {
		border-color: var(--accent);
		box-shadow: 0 0 0.8rem rgb(0 229 255 / 15%);
	}

	.profile-row :global(svg) {
		flex-shrink: 0;
		color: var(--accent);
	}

	.profile-row :global(.profile-row__external) {
		margin-left: auto;
		color: var(--muted);
		transition: color 0.2s ease;
	}

	a.profile-row:hover :global(.profile-row__external) {
		color: var(--accent);
	}

	.profile-row__text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
		font-size: 0.85rem;
	}

	.profile-row__text strong {
		font-size: 0.9rem;
		color: var(--text);
	}

	.profile-row__text span {
		color: var(--muted);
		font-family: "JetBrains Mono", Consolas, monospace;
		font-size: 0.8rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 1150px) {
		.home-layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 700px) {
		.profiles-list {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.profile-row {
			flex: 1 1 calc(50% - 0.3rem);
			min-width: 200px;
		}
	}

	@media (max-width: 480px) {
		.profile-row {
			flex: 1 1 100%;
		}
	}
</style>
