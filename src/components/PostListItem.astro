---
interface Props {
  post: { slug: string; title: string; featuredImageUrl?: string | null; dateIso: string; dateLabel: string; excerpt?: string };
}
const { post } = Astro.props;
---
						<article class="feed-item">
							{post.featuredImageUrl && (
								<a class="feed-item__thumb" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
									<img src={post.featuredImageUrl} alt="" loading="lazy" />
								</a>
							)}
							<div class="feed-item__body">
								<h3 class="feed-item__title"><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
								<p class="feed-item__date"><time datetime={post.dateIso}>{post.dateLabel}</time></p>
								{post.excerpt && <p class="feed-item__excerpt">{post.excerpt}</p>}
							</div>
						</article>
<style>
	.feed-item {
		display: flex;
		gap: 1.25rem;
		padding: 1.4rem 0;
		border-bottom: 1px solid var(--line);
	}

	.feed-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.feed-item__thumb {
		flex-shrink: 0;
		align-self: flex-start;
		display: block;
		width: 10rem;
		aspect-ratio: 16 / 10;
		border-radius: var(--r-md,10px);
		overflow: hidden;
	}

	.feed-item__thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.feed-item__body {
		min-width: 0;
		flex: 1;
		max-width: var(--measure);
	}

	.feed-item__title {
		margin: 0 0 0.3rem;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.25;
	}

	.feed-item__title a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.feed-item__title a:hover {
		color: var(--accent);
	}

	.feed-item__date {
		margin: 0 0 0.6rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.feed-item__excerpt {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		margin: 0;
		color: var(--muted);
		font-family: var(--font-read);
		font-size: 1rem;
		line-height: 1.6;
	}

	@media (max-width: 560px) {
		.feed-item {
			gap: 1rem;
		}

		.feed-item__thumb {
			width: 5.5rem;
			aspect-ratio: 1;
		}

		.feed-item__excerpt {
			-webkit-line-clamp: 2;
			line-clamp: 2;
		}
	}
</style>
