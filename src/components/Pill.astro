---
interface Props {
  variant?: 'default' | 'success' | 'warning' | 'danger' | 'info';
  size?: 'sm' | 'md';
  icon?: string;
  class?: string;
}

import Icon from './Icon.astro';

const {
  variant = 'default',
  size = 'md',
  icon,
  class: className = '',
} = Astro.props;

---

<span
  class={`pill pill--${variant} pill--${size} ${className}`}
>
  {icon && (
    <span class="pill__icon">
      <Icon name={icon} size={size === 'sm' ? 14 : 16} />
    </span>
  )}
  <slot />
</span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: var(--r-pill,999px);
    font-weight: 500;
    white-space: nowrap;
  }

  .pill {
    --pill-color: var(--accent);
    color: var(--pill-color);
    border: 1px solid rgb(from var(--pill-color) r g b / 50%);
    background: rgb(from var(--pill-color) r g b / 15%);
    font-family: var(--font-ui);
  }
  .pill--success { --pill-color: var(--accent-3); }
  .pill--warning { --pill-color: var(--warning); }
  .pill--danger { --pill-color: var(--danger); }
  .pill--info { --pill-color: var(--accent-2); }
  .pill--sm { padding: 0.3rem 0.7rem; font-size: 0.8rem; }
  .pill--md { padding: 0.4rem 0.9rem; font-size: 0.9rem; }

  .pill__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
