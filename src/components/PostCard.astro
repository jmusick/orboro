---
import Card from "./Card.astro";
interface Props {
  title: string;
  slug: string;
  image?: string | null;
  dateIso: string;
  dateLabel: string;
  excerpt?: string;
  categories?: string[];
  variant?: "compact" | "detailed";
  class?: string;
  [key: string]: unknown;
}
const { title, slug, image, dateIso, dateLabel, excerpt, categories = [], variant = "detailed", class: className = "", ...rest } = Astro.props;
---
<Card href={`/blog/${slug}`} title={title} image={variant === "detailed" ? image ?? undefined : undefined} icon="file-text" headingLevel="h2" class={`post-card post-card--${variant} ${className}`} {...rest}>
  <p class="post-card__meta">
    <time datetime={dateIso}>{dateLabel}</time>
    {categories.length > 0 && <span class="post-card__categories">{categories.join(", ")}</span>}
  </p>
  {variant === "detailed" && excerpt && <p class="post-card__excerpt">{excerpt}</p>}
</Card>
<style>
  .post-card__meta { display: flex; flex-wrap: wrap; gap: 0.15rem var(--space-4); font-size: 0.82rem; color: var(--muted); margin: 0 0 var(--space-2); }
  .post-card__categories { color: var(--accent); }
  .post-card__excerpt { margin: 0; }
</style>
