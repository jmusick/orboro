{
  "name": "orboro",
  "type": "module",
  "version": "1.32.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8787",
    "dev:astro": "astro dev --host 127.0.0.1",
    "build": "astro build && node fix-wrangler.js",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "data:assisted-combat": "node scripts/generate-assisted-combat-data.mjs",
    "data:midnight-s2-interrupts": "node scripts/generate-midnight-s2-interrupt-data.mjs",
    "data:spec-icons": "node scripts/fetch-spec-icons.mjs",
    "cf:types": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "astro": "^7.1.6",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "sharp@0.34.5": true,
    "workerd@1.20260730.1": true
  }
}
