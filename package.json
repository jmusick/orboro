{
  "name": "orboro",
  "type": "module",
  "version": "1.40.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro build && wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:astro": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "check": "astro check",
    "test:markdown": "node --experimental-strip-types --test tests/markdown.test.ts",
    "test:dates": "node --experimental-strip-types --test tests/dates.test.ts",
    "test:feed": "node --experimental-strip-types --test tests/feed.test.ts",
    "data:assisted-combat": "node scripts/generate-assisted-combat-data.mjs",
    "data:midnight-s2-interrupts": "node scripts/generate-midnight-s2-interrupt-data.mjs",
    "data:spec-icons": "node scripts/fetch-spec-icons.mjs",
    "media:migrate": "node scripts/migrate-content-images.mjs",
    "cf:types": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "astro": "^7.3.5",
    "easymde": "2.21.0",
    "font-awesome": "4.7.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "sharp@0.35.5": true,
    "workerd@1.20260926.1": true,
    "workerd@1.20260930.2": true
  }
}
